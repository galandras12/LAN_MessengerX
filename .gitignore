# C++ build artifacts
*.slo
*.lo
*.o
*.a
*.la
*.lai
*.so
*.dylib
*.obj
*.pdb
*.exe
*.dll

# Qt / qmake
/.qmake.cache
/.qmake.stash
*.pro.user
*.pro.user.*
*.qbs.user
*.qbs.user.*
*.moc
moc_*.cpp
qrc_*.cpp
ui_*.h
Makefile*
*build-*
*.autosave

# Third-party dependencies fetched locally at build time (not vendored in the repo)
/openssl/

# Android OpenSSL (KDAB android_openssl prebuilt package, ssl_3 branch) -
# unlike /openssl/ above, this IS vendored: it's the fix for a real,
# previously-documented build blocker (no Android NDK/internet access to
# produce per-ABI cross-compiled OpenSSL from a from-scratch environment),
# and it's small enough (~21 MB) to check in. Carved out of the blanket
# *.so ignore rule above.
!/openssl-android/**/*.so
/Windows/lmc/debug/
/Windows/lmc/release*/
/Windows/lmc/build/
/Windows/lmc/setup/lmc*.exe
/Windows/lmc/setup/lmc*.zip
/Windows/lmcapp/lib/
/Windows/lmcapp/bin/

# package_release.bat's output - a generated, ready-to-run folder
# (lmc.exe + windeployqt's Qt DLLs + OpenSSL DLLs + loose resources),
# never meant to be committed
/Windows-Release/

# Core static library build output
/Core/lib/
/Core/debug/
/Core/release*/
/Core/build/

# Qt Creator shadow builds - these can land anywhere a .pro file lives
# (e.g. Windows/lmc/src/build/Desktop_Qt_.../, Windows/lmcapp/src/build/...),
# not just the specific paths above, and carry machine-specific absolute
# paths (.qmake.stash, compile_commands.json) that should never be
# committed. Catches all of them regardless of nesting depth.
**/build/Desktop_Qt_*/
**/.qtc_clangd/
object_script.*

# Android / Qt for Android / Gradle build output
/Android/build/
/Android/.gradle/
/Android/android-build*/
/Android/*.apk
/Android/*.aab
local.properties
.cxx/

# IDE
CMakeLists.txt.user*
*.qmlproject.user
*.qmlproject.user.*
.vs/
.idea/
